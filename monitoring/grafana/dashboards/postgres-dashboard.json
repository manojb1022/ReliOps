      "targets": [
        {
          "expr": "(pg_stat_database_blks_hit{datname=\"reliops_db\"} / (pg_stat_database_blks_hit{datname=\"reliops_db\"} + pg_stat_database_blks_read{datname=\"reliops_db\"})) * 100",
          "refId": "A"
        }
      ],
